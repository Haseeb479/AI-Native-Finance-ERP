# ==============================================================================
# AI-Native Finance ERP — Environment Configuration Template
# ==============================================================================

# Application
APP_NAME="AI-Native Finance ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000

# Next.js Web Frontend
NEXT_PUBLIC_APP_NAME="AI-Native Finance ERP"
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# Localization & Compliance
DEFAULT_COUNTRY=PK
DEFAULT_CURRENCY=PKR
FBR_ENVIRONMENT=sandbox
FBR_INTEGRATOR_ID=
FBR_LICENSE_KEY=

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=finance_erp
DB_USERNAME=finance_user
DB_PASSWORD=secret_local_password

# Cache, Sessions & Queues (Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Object Storage (S3-Compatible / MinIO for documents, invoices, receipts)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=finance-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# AI Service (FastAPI)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://127.0.0.1:8001

# LLM Providers (Placeholder keys — do not put real credentials here)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini

# OCR Providers (Document extractions)
OCR_PROVIDER=tesseract
OCR_FALLBACK_TO_LLM=true

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@finance-erp.local"
MAIL_FROM_NAME="${APP_NAME}"
